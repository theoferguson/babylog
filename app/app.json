{
  "expo": {
    "name": "babylog",
    "slug": "baby-logging",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "babylog",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theoferguson.babylog",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Speech is turned into text on this device so you can log a feed without typing. Audio is never sent anywhere.",
        "NSMicrophoneUsageDescription": "babylog listens only while you hold the record sheet open, to turn what you say into a feed or nappy you then check before saving."
      }
    },
    "android": {
      "package": "com.theoferguson.babylog",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FDFBF9"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF9"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-speech-recognition"
    ],
    "extra": {
      "apiUrl": "https://babylog-app.fly.dev",
      "router": {},
      "eas": {
        "projectId": "c3ffeff3-e9c3-465c-b892-a039823c13e5"
      }
    },
    "owner": "ferguson-dev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c3ffeff3-e9c3-465c-b892-a039823c13e5"
    }
  }
}
